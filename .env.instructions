# INSTRUCOES: Configure as variaveis de ambiente abaixo

# 1. Abra: https://supabase.com/dashboard/project/[seu-projeto-id]/settings/database
# 2. Em "Connection string", selecione "Node.js"
# 3. Copie a URL completa (tipo: postgresql://...)
# 4. Cole aqui, substitua user:password pelos valores da sua conta Supabase

DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Token de seguranca (deixe em branco se nao usar autenticacao)
API_TOKEN=""

# Origins permitidas (opcional)
# ALLOWED_ORIGINS=http://127.0.0.1:8080

