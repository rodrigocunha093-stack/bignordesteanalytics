generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppState {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_state")
}

model Loja {
  id          String   @id @default(cuid())
  codigo      String   @unique
  nome        String
  regiao      String
  cidade      String?
  estado      String?
  status      String   @default("Ativa")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  resumos       ResumoGeralLojaMes[]
  resultados    ResultadoCampanha[]
  produtos      ProdutoCampanha[]
  departamentos DepartamentoCampanha[]
  importacoes   Importacao[]
}

model Campanha {
  id             String   @id @default(cuid())
  idTipoOferta   String   @unique
  descricao      String
  categoria      String?
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Importacao {
  id                String      @id @default(cuid())
  lojaId            String
  mes               String
  tipoArquivo       TipoArquivo
  campanha          String?
  nomeArquivo       String
  chaveDuplicidade  String      @unique
  status            String
  linhasProcessadas Int
  erros             Json?
  dataImportacao    DateTime    @default(now())

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([lojaId, mes, tipoArquivo, campanha])
}

model ResumoGeralLojaMes {
  id             String  @id @default(cuid())
  lojaId         String
  mes            String
  vendaTotal     Decimal @db.Decimal(14, 2)
  custoTotal     Decimal @db.Decimal(14, 2)
  lucroTotal     Decimal @db.Decimal(14, 2)
  margemTotal    Decimal @db.Decimal(8, 4)
  cuponsTotais   Int
  unidadesTotais Decimal @db.Decimal(14, 3)

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@unique([lojaId, mes])
}

model ResultadoCampanha {
  id                String  @id @default(cuid())
  lojaId            String
  mes               String
  idTipoOferta      String
  descricao         String
  venda             Decimal @db.Decimal(14, 2)
  custo             Decimal @db.Decimal(14, 2)
  lucro             Decimal @db.Decimal(14, 2)
  margem            Decimal @db.Decimal(8, 4)
  quantidade        Decimal @db.Decimal(14, 3)
  itens             Int
  produtosDistintos Int
  cupons            Int
  ticketMedio       Decimal @db.Decimal(14, 2)
  precoMedio        Decimal @db.Decimal(14, 2)

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@unique([lojaId, mes, idTipoOferta])
  @@index([mes, descricao])
}

model ProdutoCampanha {
  id               String  @id @default(cuid())
  lojaId           String
  mes              String
  idTipoOferta     String
  campanha         String
  idProduto        String
  descricaoProduto String
  quantidade       Decimal @db.Decimal(14, 3)
  venda            Decimal @db.Decimal(14, 2)
  lucro            Decimal @db.Decimal(14, 2)
  margem           Decimal @db.Decimal(8, 4)

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([lojaId, mes, campanha])
  @@index([idProduto])
}

model DepartamentoCampanha {
  id                    String  @id @default(cuid())
  lojaId                String
  mes                   String
  idTipoOferta          String
  campanha              String
  mercadologico1        String
  descricaoDepartamento String
  produtos              Int
  quantidade            Decimal @db.Decimal(14, 3)
  venda                 Decimal @db.Decimal(14, 2)
  lucro                 Decimal @db.Decimal(14, 2)
  margem                Decimal @db.Decimal(8, 4)

  loja Loja @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([lojaId, mes, campanha])
  @@index([mercadologico1])
}

model CuponsCampanha {
  id             String @id @default(cuid())
  lojaCodigo     String
  mes            String
  cuponsTotais   Int
  campanha       String
  cuponsCampanha Int

  @@unique([lojaCodigo, mes, campanha])
}

enum TipoArquivo {
  RESUMO_GERAL_LOJA_MES
  RESULTADO_CAMPANHA
  PRODUTOS_CAMPANHA
  DEPARTAMENTOS_CAMPANHA
  CUPONS_CAMPANHA
}

model EncarteBenchmark {
  id                 String   @id @default(cuid())
  rede               String
  campanha           String
  dataInicio          DateTime @map("data_inicio") @db.Date
  dataFim             DateTime @map("data_fim") @db.Date
  quantidadePaginas  Int      @default(1) @map("quantidade_paginas")
  totalEstimado       Int?     @map("total_estimado")
  arquivoOrigem      String?  @map("arquivo_origem")
  observacao         String?
  notaVisual          Decimal  @default(70) @map("nota_visual") @db.Decimal(5, 2)
  notaMix             Decimal  @default(70) @map("nota_mix") @db.Decimal(5, 2)
  status              String   @default("Em revisao")
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  itens EncarteItemBenchmark[]

  @@index([rede, dataInicio, dataFim])
  @@map("benchmark_encartes")
}

model EncarteItemBenchmark {
  id                  String   @id @default(cuid())
  encarteId           String   @map("encarte_id")
  pagina              Int      @default(1)
  departamento        String
  categoriaFuncional  String   @map("categoria_funcional")
  subcategoria        String?
  produto             String
  marca               String?
  embalagem           String?
  unidadeComparacao   String?  @map("unidade_comparacao")
  quantidadeEmbalagem Decimal? @map("quantidade_embalagem") @db.Decimal(12, 3)
  precoDe             Decimal? @map("preco_de") @db.Decimal(12, 2)
  precoPor            Decimal  @map("preco_por") @db.Decimal(12, 2)
  precoNormalizado    Decimal? @map("preco_normalizado") @db.Decimal(12, 4)
  tipoProduto         String?  @map("tipo_produto")
  produtoAncora       Boolean  @default(false) @map("produto_ancora")
  destaqueCapa        Boolean  @default(false) @map("destaque_capa")
  revisado            Boolean  @default(false)
  observacao          String?
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  encarte EncarteBenchmark @relation(fields: [encarteId], references: [id], onDelete: Cascade)

  @@index([encarteId, categoriaFuncional])
  @@index([departamento])
  @@map("benchmark_encarte_itens")
}
